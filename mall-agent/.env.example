# Copy to .env locally. Never commit real keys.
# Database and bridge credentials are injected by deployment/dev.cjs.
AGENT_PROVIDER=openai_responses
AGENT_DIALOG_BASE_URL=https://fushengyunsuan.cn/v1
AGENT_DIALOG_API_KEY=replace-with-gpt-provider-key
AGENT_DIALOG_MODEL=gpt-6.1-sol
AGENT_ALI_COMPATIBLE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AGENT_ALI_NATIVE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1
AGENT_ALI_API_KEY=replace-with-aliyun-workspace-key
AGENT_EMBEDDING_MODEL=text-embedding-v4
AGENT_EMBEDDING_DIMENSION=1024
AGENT_RERANK_MODEL=qwen3-rerank
AGENT_ASR_MODEL=qwen3-asr-flash
AGENT_TTS_MODEL=qwen3-tts-flash
AGENT_VISION_MODEL=gpt-6.1-sol
AGENT_VISION_ENABLED=true
AGENT_ATTACHMENTS_ENABLED=false
# Enable attachments after provisioning a private bucket and scoped credentials.
AGENT_OBJECTS_ENDPOINT=127.0.0.1:19000
AGENT_OBJECTS_BUCKET=mall-agent-private
AGENT_OBJECTS_ACCESS_KEY=replace-with-scoped-object-access-key
AGENT_OBJECTS_SECRET_KEY=replace-with-scoped-object-secret-key
AGENT_MODEL_DAILY_REQUESTS=200
AGENT_BUILD=knowledge-0.6
AGENT_GOVERNANCE_ENABLED=false
AGENT_RETENTION_ENABLED=false
# Enable after migrations 0008/0009 and provisioning explicit staff capabilities.
AGENT_KNOWLEDGE_ENABLED=false
# Scoped vector users are injected per process by the manager after prepare_vector_access.py.
AGENT_MILVUS_URI=http://127.0.0.1:19530
AGENT_MILVUS_DATABASE=mall_agent
# Provision with deployment/prepare-agent-runtime.cjs before enabling notifications.
AGENT_STAFF_BRIDGE_SECRET=
AGENT_NOTIFICATIONS_ENABLED=false
AGENT_REDIS_URL=
AGENT_RABBIT_URL=
AGENT_NOTIFICATION_NAMESPACE=mall-agent
AGENT_JOB_LEASE_SECONDS=30
AGENT_JOB_TIMEOUT_SECONDS=60
AGENT_JOB_RETRY_BASE_SECONDS=2

# Enable order checkout only after prepare-order-schema.cjs and the portal adapter are deployed.
AGENT_ORDERS_ENABLED=false
